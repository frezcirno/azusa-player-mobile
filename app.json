{
  "name": "azusa-player-mobile",
  "displayName": "APM",
  "plugins": [
    "react-native-ota-hot-update"
  ],
  "expo": {
    "scheme": [
      "com.noxplayer",
      "noxplayer"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noxplay.noxplayer"
    }
  }
}
